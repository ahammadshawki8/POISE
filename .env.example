# YouCam / Perfect Corp S2S API credentials (from the API Console)
# Get 1,000 free hackathon units via Account > Redeem Code.
YOUCAM_API_KEY=your_api_key_here          # used as client_id
YOUCAM_SECRET_KEY=your_secret_key_here    # used as client_secret (Base64 X.509 RSA public key)

# Optional overrides
# YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# Groq (reasoning + intent + styling). Free at console.groq.com
# GROQ_API_KEY=your_groq_key_here
# OpenRouter (free vision for outfit recognition). Free at openrouter.ai/keys
# OPENROUTER_KEY=your_openrouter_key_here
# Optional: pin a specific OpenRouter vision model (tried first)
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
